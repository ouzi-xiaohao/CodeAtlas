CODEATLAS_ENV=development
CODEATLAS_LOG_LEVEL=INFO
CODEATLAS_POSTGRES_DSN=postgresql://codeatlas:codeatlas@localhost:5432/codeatlas
CODEATLAS_REDIS_URL=redis://localhost:6379/0
CODEATLAS_QDRANT_URL=http://localhost:6333
# Optional cross-encoder endpoint; local feature reranker is used when omitted.
CODEATLAS_RERANKER_URL=
CODEATLAS_EMBEDDING_BACKEND=hash
CODEATLAS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CODEATLAS_EMBEDDING_DIMENSIONS=512
CODEATLAS_RERANKER_BACKEND=feature
CODEATLAS_RERANKER_MODEL=BAAI/bge-reranker-base
CODEATLAS_GITHUB_TOKEN=
CODEATLAS_GITHUB_API_URL=https://api.github.com
CODEATLAS_NEO4J_URI=bolt://localhost:7687
CODEATLAS_NEO4J_USER=neo4j
CODEATLAS_NEO4J_PASSWORD=codeatlas-password
CODEATLAS_OTLP_ENDPOINT=http://localhost:4317
CODEATLAS_REPOSITORY_ROOT=.
CODEATLAS_ENABLE_EXTERNAL_SERVICES=false
CODEATLAS_WRITE_CONFIRMATION_SECRET=change-me
